<?xml version="1.0" encoding="UTF-8"?>
<!--
  Companion launchd plist template.

  The runtime artifact lives at ~/Library/LaunchAgents/com.calmdemy.companion.plist.
  Don't edit that copy directly — edit this template and re-run install_launchd.sh.

  Placeholders rendered by install_launchd.sh:
    {{WORKER_DIR}}    absolute path to <repo>/worker
    {{HOMEBREW_BIN}}  /opt/homebrew/bin (Apple Silicon) or /usr/local/bin (Intel)

  Notes:
    - ProgramArguments runs run_companion.sh, NOT python directly. The shell
      script provisions every venv (.venv, .venv-qwen, .venv-qc) before
      execing into local_companion.py. Skipping it leaves new venvs missing
      and stacks crash-loop with ModuleNotFoundError.
    - PATH includes both Homebrew prefixes so launchd-spawned processes can
      find ffmpeg / ffprobe (used by Whisper QC, audio post-processing).
      launchd does NOT inherit your shell PATH.
    - KeepAlive.SuccessfulExit=false respawns on crash but not when the
      companion exits cleanly (e.g. shutdown).
    - ThrottleInterval prevents tight respawn loops on persistent failures.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.calmdemy.companion</string>

  <key>WorkingDirectory</key>
  <string>{{WORKER_DIR}}</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{WORKER_DIR}}/run_companion.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>{{WORKER_DIR}}/logs/companion-launchd.log</string>

  <key>StandardErrorPath</key>
  <string>{{WORKER_DIR}}/logs/companion-launchd.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{WORKER_DIR}}/.venv/bin:{{HOMEBREW_BIN}}:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
